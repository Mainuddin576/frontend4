<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smallest Unique Subarray</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: system-ui, "Segoe UI", sans-serif;
    background: #0f172a;
    color: #e2e8f0;
    padding: 32px 16px;
    line-height: 1.5;
  }
  main { max-width: 720px; margin: 0 auto; }
  h1 { font-size: 1.8rem; margin-bottom: 6px; }
  .sub { color: #94a3b8; margin-bottom: 24px; }
  .card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 16px;
  }
  label { display: block; font-weight: 600; margin-bottom: 8px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
  input {
    flex: 1;
    min-width: 200px;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #475569;
    background: #0f172a;
    color: inherit;
    font-size: 1rem;
  }
  button {
    padding: 12px 18px;
    border: 0;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    background: #38bdf8;
    color: #082f49;
  }
  button:hover { filter: brightness(1.1); }
  button.example { background: #334155; color: #e2e8f0; padding: 6px 12px; font-size: .85rem; }
  input:focus-visible, button:focus-visible { outline: 2px solid #facc15; outline-offset: 2px; }
  .examples { margin-top: 12px; }
  .error { color: #fca5a5; margin-top: 10px; }
  .hidden { display: none; }
  .answer { font-size: 3rem; font-weight: 700; color: #4ade80; }
  .boxes { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .box {
    min-width: 42px;
    padding: 8px;
    text-align: center;
    border-radius: 6px;
    background: #334155;
  }
  .box.hit { background: #4ade80; color: #052e16; font-weight: 700; }
  .step { margin-top: 14px; }
  .chip {
    display: inline-block;
    margin: 4px 6px 0 0;
    padding: 4px 10px;
    border-radius: 999px;
    background: #334155;
    font-size: .9rem;
  }
  .chip.unique { background: #14532d; color: #bbf7d0; }
</style>
</head>
<body>
<main>
  <h1>Smallest Unique Subarray</h1>
  <p class="sub">Sabse chhoti length ka subarray jo array mein sirf ek baar aata hai.</p>

  <form class="card" id="form">
    <label for="nums">Array (comma se alag karein)</label>
    <div class="row">
      <input id="nums" value="1,1,2,2,1" autocomplete="off">
      <button type="submit">Solve</button>
    </div>
    <div class="row examples">
      <button type="button" class="example" data-v="3,3,3">Example 1</button>
      <button type="button" class="example" data-v="2,1,2,3,3">Example 2</button>
      <button type="button" class="example" data-v="1,1,2,2,1">Example 3</button>
    </div>
    <p class="error" id="error" role="alert"></p>
  </form>

  <section class="card hidden" id="result">
    <p>Minimum length</p>
    <div class="answer" id="answer"></div>
    <p id="found"></p>
    <div class="boxes" id="boxes"></div>
  </section>

  <section class="card hidden" id="stepsCard">
    <strong>Step by step</strong>
    <div id="steps"></div>
  </section>
</main>

<script>
const $ = id => document.getElementById(id);

function solve(nums) {
  const steps = [];
  for (let len = 1; len <= nums.length; len++) {
    const map = new Map();
    for (let i = 0; i + len <= nums.length; i++) {
      const key = nums.slice(i, i + len).join(", ");
      if (!map.has(key)) map.set(key, { count: 0, start: i });
      map.get(key).count++;
    }
    steps.push({ len, map });
    for (const [key, info] of map) {
      if (info.count === 1) return { len, key, start: info.start, steps };
    }
  }
}

function el(tag, className, text) {
  const node = document.createElement(tag);
  node.className = className;
  node.textContent = text;
  return node;
}

function run() {
  const parts = $("nums").value.split(",").map(s => s.trim());
  const nums = parts.map(Number);
  const valid = parts.length <= 50 &&
    parts.every((s, i) => /^\d+$/.test(s) && nums[i] >= 1 && nums[i] <= 100000);

  $("result").classList.toggle("hidden", !valid);
  $("stepsCard").classList.toggle("hidden", !valid);
  $("error").textContent = valid ? "" : "1 se 100000 tak ke numbers daalein (maximum 50).";
  if (!valid) return;

  const res = solve(nums);
  $("answer").textContent = res.len;
  $("found").textContent = `Unique subarray: [${res.key}]`;

  $("boxes").replaceChildren(...nums.map((n, i) =>
    el("div", i >= res.start && i < res.start + res.len ? "box hit" : "box", n)));

  $("steps").replaceChildren(...res.steps.map(step => {
    const block = el("div", "step", "");
    block.append(el("div", "", `Length ${step.len}`));
    for (const [key, info] of step.map) {
      block.append(el("span", info.count === 1 ? "chip unique" : "chip",
        `[${key}] × ${info.count}`));
    }
    return block;
  }));
}

$("form").addEventListener("submit", e => { e.preventDefault(); run(); });
document.querySelectorAll(".example").forEach(btn =>
  btn.addEventListener("click", () => { $("nums").value = btn.dataset.v; run(); }));
run();
</script>
</body>
</html>
